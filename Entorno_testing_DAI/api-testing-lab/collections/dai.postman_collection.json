{
  "info": {
    "name": "DAI — Laboratorio de testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "15 casos reproducibles. API de tareas local. Ejecutar en orden desde 00. Datos ficticios y autenticación simulada."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 Reiniciar datos",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/testing/reset",
        "description": "Esperado: 200. Ejecutar en orden desde 00 para preparar datos y variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Reset confirmado', () => pm.expect(body.reset).to.eql(true));",
              "pm.collectionVariables.set('token', '');",
              "pm.collectionVariables.set('taskId', '');"
            ]
          }
        }
      ]
    },
    {
      "name": "01 API encendida",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "description": "Esperado: 200. Ejecutar en orden desde 00 para preparar datos y variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Estado correcto', () => pm.expect(body.status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login incorrecto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "description": "Esperado: 401. Ejecutar en orden desde 00 para preparar datos y variables.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alumno@demo.com\",\n  \"password\": \"mal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Error explicado', () => pm.expect(body.error).to.eql('Credenciales inválidas'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login correcto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "description": "Esperado: 200. Ejecutar en orden desde 00 para preparar datos y variables.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alumno@demo.com\",\n  \"password\": \"Demo1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Token recibido', () => pm.expect(body.token).to.eql('token-demo-dai'));",
              "pm.test('Email correcto', () => pm.expect(body.user.email).to.eql('alumno@demo.com'));",
              "pm.test('No expone contraseña', () => pm.expect(Object.prototype.hasOwnProperty.call(body.user, 'password')).to.eql(false));",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Listado inicial",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks",
        "description": "Esperado: 200. Ejecutar en orden desde 00 para preparar datos y variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Una tarea inicial', () => pm.expect(body.tasks.length).to.eql(1));",
              "pm.test('Título inicial', () => pm.expect(body.tasks[0].title).to.eql('Preparar presentación DAI'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Crear sin token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "description": "Esperado: 401. Ejecutar en orden desde 00 para preparar datos y variables.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Tarea sin permiso\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Rechaza acceso', () => pm.expect(body.error).to.eql('Token ausente o inválido'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Crear título inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "description": "Esperado: 400. Ejecutar en orden desde 00 para preparar datos y variables.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"ab\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Explica validación', () => pm.expect(body.error).to.eql('El título debe tener entre 3 y 100 caracteres'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Errores no crearon tareas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks",
        "description": "Esperado: 200. Ejecutar en orden desde 00 para preparar datos y variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Sigue habiendo una tarea', () => pm.expect(body.tasks.length).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Crear tarea válida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "description": "Esperado: 201. Ejecutar en orden desde 00 para preparar datos y variables.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Probar API en clase\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Identificador correcto', () => pm.expect(body.id).to.eql(2));",
              "pm.test('Título correcto', () => pm.expect(body.title).to.eql('Probar API en clase'));",
              "pm.test('Comienza pendiente', () => pm.expect(body.completed).to.eql(false));",
              "pm.collectionVariables.set('taskId', String(body.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Consultar tarea creada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "description": "Esperado: 200. Ejecutar en orden desde 00 para preparar datos y variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Es la tarea creada', () => pm.expect(body.id).to.eql(2));",
              "pm.test('Título guardado', () => pm.expect(body.title).to.eql('Probar API en clase'));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Completar con tipo incorrecto",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "description": "Esperado: 400. Ejecutar en orden desde 00 para preparar datos y variables.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": \"true\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Rechaza string', () => pm.expect(body.error).to.eql('completed debe ser booleano'));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Completar tarea",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "description": "Esperado: 200. Ejecutar en orden desde 00 para preparar datos y variables.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Quedó completada', () => pm.expect(body.completed).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Borrar tarea",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "description": "Esperado: 204. Ejecutar en orden desde 00 para preparar datos y variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));",
              "pm.test('Respuesta sin body', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Consultar tarea borrada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "description": "Esperado: 404. Ejecutar en orden desde 00 para preparar datos y variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Ya no existe', () => pm.expect(body.error).to.eql('Tarea no encontrada'));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Listado final limpio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks",
        "description": "Esperado: 200. Ejecutar en orden desde 00 para preparar datos y variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Solo queda la inicial', () => pm.expect(body.tasks.length).to.eql(1));"
            ]
          }
        }
      ]
    }
  ]
}
